# LLM provider factory (app/llm.py).
# Required. Values: openai | openrouter | ollama | lmstudio | anthropic | google
LLM_PROVIDER=

# Model override; each provider has a sensible default (see app/llm.py).
LLM_MODEL=

# API key. Required for openai, openrouter, anthropic and google.
# Ollama and LM Studio accept any placeholder value, such as "ollama".
LLM_API_KEY=

# Base URL override for OpenAI-compatible providers.
# Leave empty to use the provider default.
LLM_BASE_URL=

# Adaptive Zelda Wiki RAG (Phase 7).
# Qdrant runs in embedded local mode at this persistent path; do not point it at
# a Qdrant server URL. The directory is created automatically and can be safely
# deleted when a clean cache is wanted.
RAG_QDRANT_PATH=.cache/termina-companion/qdrant

# FastEmbed model used for local semantic embeddings.
# The default is multilingual, runs locally through ONNX and has 384 dimensions.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Minimum cosine score for a cached vector result to count as sufficient.
# This is provisional and should be calibrated with retrieval scenarios.
RAG_SIMILARITY_THRESHOLD=0.72

# Number of vector evidence chunks returned to the Knowledge Agent.
RAG_TOP_K=4

# Maximum wiki pages fetched and indexed during one cache miss.
RAG_MAX_PAGES_PER_MISS=3

# Maximum evidence chunks kept per wiki page. Overlapping windows are also
# de-duplicated, so a single page cannot crowd out the other sources.
RAG_MAX_CHUNKS_PER_SOURCE=2

# Timeout in seconds for each MediaWiki request.
RAG_REQUEST_TIMEOUT_SECONDS=20

# Overall wall-clock budget in seconds for the wiki leg of one cache miss
# (search + page fetches + revision checks). 0 disables the budget.
RAG_WIKI_BUDGET_SECONDS=60

# Age in seconds after which a warm cache hit is revalidated against the wiki.
# Only pages whose revision actually changed are refetched. 0 never expires.
RAG_CACHE_TTL_SECONDS=604800

# Examples:
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
#
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o-mini
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
#
# LLM_PROVIDER=google
# LLM_API_KEY=...
