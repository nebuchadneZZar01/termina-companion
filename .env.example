# LLM provider factory (app/llm.py).
# Required. Values: openai | openrouter | ollama | lmstudio | anthropic | google
LLM_PROVIDER=

# Model override; each provider has a sensible default (see app/llm.py).
LLM_MODEL=

# API key. Required for openai, openrouter, anthropic, google.
# ollama / lmstudio accept any placeholder (e.g. "ollama").
LLM_API_KEY=

# Base URL override for OpenAI-compatible providers
# (OpenAI/OpenRouter/Ollama/LM Studio already have sane defaults).
LLM_BASE_URL=

# Optional local RAG retrieval. Set to 0 to disable supplemental evidence.
RAG_ENABLED=1

# Examples:
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
#
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o-mini
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
#
# LLM_PROVIDER=google
# LLM_API_KEY=...