# LLM provider factory (app/llm.py).
# Required. Values: openai | openrouter | ollama | lmstudio | anthropic | google
LLM_PROVIDER=

# Model override; each provider has a sensible default (see app/llm.py).
LLM_MODEL=

# API key. Required for openai, openrouter, anthropic and google.
# Ollama and LM Studio accept any placeholder value, such as "ollama".
LLM_API_KEY=

# Base URL override for OpenAI-compatible providers.
# Leave empty to use the provider default.
# Ollama and LM Studio serve the OpenAI-compatible API under /v1:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_BASE_URL=http://localhost:1234/v1
LLM_BASE_URL=

# Logging. Optional; default INFO.
# INFO shows every app log, including the planning prompts (system/user) and
# the raw assistant answer, each bounded by app.trace.LLM_LOG_PAYLOAD_LIMIT.
# DEBUG additionally opens third-party noise (Streamlit's file watcher,
# LangChain, the MCP server).
LOG_LEVEL=INFO

# Planner engine. Optional; default llm.
# llm        the product path: the configured provider builds the plan.
# deterministic  evaluation baseline: the objective chain is rebuilt without an
#            LLM call, so a sweep measures what the model adds. Not a fallback:
#            the CLI exposes the same switch as --planner, and a per-run value
#            (the evaluation harness) wins over this variable.
PLANNER=llm

# Observability. Optional.
# When set, OpenTelemetry spans (pipeline, agents, LLM calls, MCP, RAG) are
# exported there over OTLP/HTTP. Start the local Phoenix backend with
# `docker compose up -d` and use http://localhost:6006 — Phoenix serves both
# the web UI and the OTLP/HTTP receiver (/v1/traces) on that port. When empty,
# tracing is a cheap no-op and no connection is ever opened.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# Phoenix base URL used to post span annotations (plan validation, evaluation
# scores). Leave empty to reuse OTEL_EXPORTER_OTLP_ENDPOINT.
PHOENIX_BASE_URL=

# Adaptive Zelda Wiki RAG.
# Supplemental retrieval switch. 0/false/off/no disables the wiki leg and the
# pipeline continues on structured MCP data (used for evaluation A/B sweeps).
RAG_ENABLED=1

# Qdrant runs in embedded local mode at this persistent path; do not point it at
# a Qdrant server URL. The directory is created automatically and can be safely
# deleted when a clean cache is wanted.
RAG_QDRANT_PATH=.cache/termina-companion/qdrant

# FastEmbed model used for local semantic embeddings.
# The default is multilingual, runs locally through ONNX and has 384 dimensions.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Minimum cosine score for a cached vector result to count as sufficient.
# Provisional, calibrated 2026-10-10 on 14 live scenarios (0.60: 7/14).
RAG_SIMILARITY_THRESHOLD=0.60

# Number of vector evidence chunks returned to the Knowledge Agent.
RAG_TOP_K=4

# Maximum wiki pages fetched and indexed during one cache miss.
RAG_MAX_PAGES_PER_MISS=3

# Maximum evidence chunks kept per wiki page. Overlapping windows are also
# de-duplicated, so a single page cannot crowd out the other sources.
RAG_MAX_CHUNKS_PER_SOURCE=2

# Timeout in seconds for each MediaWiki request.
RAG_REQUEST_TIMEOUT_SECONDS=20

# Overall wall-clock budget in seconds for the wiki leg of one cache miss
# (search + page fetches + revision checks). 0 disables the budget.
RAG_WIKI_BUDGET_SECONDS=60

# Consecutive unreachable wiki failures before the circuit breaker opens and
# short-circuits the wiki leg for a cooldown period. 0 disables the breaker.
RAG_WIKI_FAILURE_THRESHOLD=3

# Cooldown in seconds during which the wiki leg is skipped while the circuit
# breaker is open. Once it elapses, one half-open request probes the wiki.
RAG_WIKI_COOLDOWN_SECONDS=60

# Age in seconds after which a warm cache hit is revalidated against the wiki.
# Only pages whose revision actually changed are refetched. 0 never expires.
RAG_CACHE_TTL_SECONDS=604800

# Examples:
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
#
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o-mini
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
#
# LLM_PROVIDER=google
# LLM_API_KEY=...
